# ─── Checkbot RAG ─────────────────────────────────────────────────────────────
# Fact-check RAG service with hybrid vector + full-text search.
# Admin UI: http://checkbot-rag.localhost
# MCP endpoint: /mcp (clients use this instance's URL)

CHECKBOT_RAG_PORT=3020

# PostgreSQL (own instance, isolated from LibreChat vectordb)
CHECKBOT_RAG_POSTGRES_DB=checkbot_rag
CHECKBOT_RAG_POSTGRES_USER=checkbot_rag
CHECKBOT_RAG_POSTGRES_PASSWORD=

# Embedding — Scaleway Qwen3-Embedding-8B (MTEB multilingual #1, €0.10/M tokens)
# API is OpenAI-compatible; also supports: openrouter, openai
CHECKBOT_RAG_EMBEDDING_PROVIDER=scaleway
CHECKBOT_RAG_EMBEDDING_MODEL=qwen3-embedding-8b
CHECKBOT_RAG_EMBEDDING_API_KEY=
CHECKBOT_RAG_EMBEDDING_BASE_URL=https://api.scaleway.ai/v1
# Matryoshka dimensions: Qwen3 supports 32–4096; pgvector ANN indexes support up to 2000 dims.
# 1536 is a good default; reduce further (e.g. 1024) when approaching 500k+ claims to save memory.
CHECKBOT_RAG_EMBEDDING_DIMENSIONS=1536
CHECKBOT_RAG_EMBEDDING_BATCH_SIZE=32

# Hybrid Search tuning (RRF — Reciprocal Rank Fusion)
CHECKBOT_RAG_SEARCH_WEIGHT_VEC=1.0
CHECKBOT_RAG_SEARCH_WEIGHT_FTS=0.5
CHECKBOT_RAG_RRF_K=60
CHECKBOT_RAG_SEARCH_OVERFETCH=3

# Chunking
CHECKBOT_RAG_MAX_CHUNK_CHARS=6000

# === Session (required in production) ===
# Generate with: openssl rand -hex 32
CHECKBOT_RAG_SESSION_SECRET=
CHECKBOT_RAG_SESSION_LIFETIME_DAYS=7
CHECKBOT_RAG_SESSION_MAX_LIFETIME_DAYS=30

# === Bootstrap (idempotent, re-read on every startup) ===
# Initial admin user - can be unset after first login and creating a permanent admin
CHECKBOT_RAG_BOOTSTRAP_ADMIN_EMAIL=
CHECKBOT_RAG_BOOTSTRAP_ADMIN_PASSWORD=

# Service users (env change rotates the key automatically)
# faktenforum → checkbot-rag inbound calls
CHECKBOT_RAG_BOOTSTRAP_FAKTENFORUM_KEY=
# MCP agent → checkbot-rag /mcp
CHECKBOT_RAG_BOOTSTRAP_MCP_KEY=

# === Rate limiting (in-memory, per API key) ===
CHECKBOT_RAG_RATE_LIMIT_ENABLED=true
CHECKBOT_RAG_RATE_LIMIT_DEFAULT_POINTS=60
CHECKBOT_RAG_RATE_LIMIT_DEFAULT_DURATION_SEC=60
CHECKBOT_RAG_RATE_LIMIT_SEARCH_POINTS=30
CHECKBOT_RAG_RATE_LIMIT_IMPORT_POINTS=10

# Faktenforum sync (optional). URL and API key for the connected Faktenforum instance.
# CHECKBOT_RAG_FAKTENFORUM_API_KEY must match FAKTENFORUM_EXPORT_API_KEY in faktenforum's .env.
CHECKBOT_RAG_FAKTENFORUM_URL=
CHECKBOT_RAG_FAKTENFORUM_API_KEY=
