# ─── Search ─────────────────────────────────────────────────────────────
# Fact-check RAG service with hybrid vector + full-text search.
# Admin UI: http://search.localhost
# MCP endpoint: /mcp (clients use this instance's URL)

SEARCH_PORT=3020

# PostgreSQL (own instance, isolated from LibreChat vectordb)
SEARCH_POSTGRES_DB=search
SEARCH_POSTGRES_USER=search
SEARCH_POSTGRES_PASSWORD=

# Embedding — Scaleway Qwen3-Embedding-8B (MTEB multilingual #1, €0.10/M tokens)
# API is OpenAI-compatible; also supports: openrouter, openai
SEARCH_EMBEDDING_PROVIDER=scaleway
SEARCH_EMBEDDING_MODEL=qwen3-embedding-8b
SEARCH_EMBEDDING_API_KEY=
SEARCH_EMBEDDING_BASE_URL=https://api.scaleway.ai/v1
# Matryoshka dimensions: Qwen3 supports 32–4096; pgvector ANN indexes support up to 2000 dims.
# 1536 is a good default; reduce further (e.g. 1024) when approaching 500k+ claims to save memory.
SEARCH_EMBEDDING_DIMENSIONS=1536
SEARCH_EMBEDDING_BATCH_SIZE=32

# Hybrid Search tuning (RRF — Reciprocal Rank Fusion)
SEARCH_WEIGHT_VEC=1.0
SEARCH_WEIGHT_FTS=0.5
SEARCH_RRF_K=60
SEARCH_OVERFETCH=3

# Chunking
SEARCH_MAX_CHUNK_CHARS=6000

# === Session (required in production) ===
# Generate with: openssl rand -hex 32
SEARCH_SESSION_SECRET=
SEARCH_SESSION_LIFETIME_DAYS=7
SEARCH_SESSION_MAX_LIFETIME_DAYS=30

# === Bootstrap (idempotent, re-read on every startup) ===
# Initial admin user - can be unset after first login and creating a permanent admin
SEARCH_BOOTSTRAP_ADMIN_EMAIL=
SEARCH_BOOTSTRAP_ADMIN_PASSWORD=

# Service users (env change rotates the key automatically)
# faktenforum → search inbound calls
SEARCH_BOOTSTRAP_FAKTENFORUM_KEY=
# MCP agent → search /mcp
SEARCH_BOOTSTRAP_MCP_KEY=

# === Rate limiting (in-memory, per API key) ===
SEARCH_RATE_LIMIT_ENABLED=true
SEARCH_RATE_LIMIT_DEFAULT_POINTS=60
SEARCH_RATE_LIMIT_DEFAULT_DURATION_SEC=60
SEARCH_RATE_LIMIT_POINTS=30
SEARCH_RATE_LIMIT_IMPORT_POINTS=10
# Login brute-force defense (applied before auth, keyed by IP and email)
SEARCH_RATE_LIMIT_LOGIN_IP_POINTS=10
SEARCH_RATE_LIMIT_LOGIN_IP_DURATION_SEC=900
SEARCH_RATE_LIMIT_LOGIN_EMAIL_POINTS=5
SEARCH_RATE_LIMIT_LOGIN_EMAIL_DURATION_SEC=900

# === Metrics ===
# Comma-separated list of IP prefixes allowed to scrape /metrics.
# Defaults to loopback + RFC 1918 private ranges (127.0.0.1,::1,10.,172.,192.168.)
SEARCH_METRICS_ALLOWED_IPS=

# Faktenforum sync (optional). URL and API key for the connected Faktenforum instance.
# SEARCH_FAKTENFORUM_API_KEY must match FAKTENFORUM_EXPORT_API_KEY in faktenforum's .env.
SEARCH_FAKTENFORUM_URL=
SEARCH_FAKTENFORUM_API_KEY=
